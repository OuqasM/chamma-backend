*.log
.DS_Store

# Any real environment file, including ad-hoc copies such as
# .env.sqlite-backup. Only the template is committed.
.env
.env.*
!.env.example
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage

# Storefront imagery. Nothing here is authored content: ImageLibrary generates
# the product shots, category art, brand logos and editorial artwork on demand
# (db:seed, or the first request that needs them), and admin photo uploads land
# in uploads/. All of it is derived, so it is regenerated per host rather than
# carried in the repository. Only the placeholder keeps the directory itself.
/public/images/*
!/public/images/.gitkeep

# Storefront build output. The compiled app is not in this repository: it is
# built from the frontend and copied into public/ on the host, where
# routes/web.php serves it.
/public/index.html
/public/assets
/public/hero
/public/favicon.svg
/public/chamma-store-logo.png
/public/cih-virement-rib.jpg
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db
