APP_NAME="Chamma Store"
# Production defaults: APP_ENV=production is also what makes `db:seed` create
# only the admin account. The compose stack overrides these for local work.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Base URL of the API. Image URLs and absolute links are built from it, so it
# has to be the host the public actually reaches.
APP_URL=https://api.chammastore.com

# Origins allowed to call the API from a browser. The storefront is served from
# a different host than the API, so the browser preflights every request. Leave
# empty to allow any origin (local development, single origin deployments).
CORS_ALLOWED_ORIGINS=https://chammastore.com,https://www.chammastore.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Storefront settings
# ---------------------------------------------------------------------------

# Contact shown to customers. The defaults below are placeholders only.
STORE_EMAIL=
STORE_PHONE=
STORE_ADDRESS=

# Public social handles, e.g. chamma-perfumes
STORE_INSTAGRAM=
STORE_FACEBOOK=
STORE_TIKTOK=

# Fallback contact number used for order links (digits, no "+" or spaces).
STORE_WHATSAPP=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# COD needs nothing. Bank transfer shows these details to the customer on the
# checkout page and on the order confirmation, so fill them in only on a
# deployment that actually collects bank transfers.

# Number customers message after placing an order.
STORE_PAYMENT_WHATSAPP=

# Account shown for wire transfers.
STORE_BANK_HOLDER=
STORE_BANK_NAME=
STORE_BANK_RIB=
STORE_BANK_IBAN=
# Public URL of a scan or logo of the transfer instructions, e.g.
# /cih-virement-rib.jpg — served from the frontend's public/ directory.
STORE_BANK_IMAGE=

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
# The admin seeder refuses to run without a password: it has no default,
# because a default committed to a repository is a published credential.
# Generate one with: php -r 'echo bin2hex(random_bytes(12)), PHP_EOL;'
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
